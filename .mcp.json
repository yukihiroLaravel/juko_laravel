{
    "mcpServers": {
        "laravel-boost": {
            "command": "docker",
            "args": [
                "compose",
                "-f",
                "../../compose.yml",
                "exec",
                "-T",
                "-w",
                "/var/www/html/laravelapp",
                "app",
                "php",
                "artisan",
                "boost:mcp"
            ]
        }
    }
}
